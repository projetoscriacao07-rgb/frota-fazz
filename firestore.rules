rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function souAdmin() {
      return logado() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if logado();
      allow create: if logado() && request.auth.uid == uid;
      allow update: if logado() && (request.auth.uid == uid || souAdmin());
      allow delete: if souAdmin();
    }

    match /colaboradores/{id} {
      allow read: if logado();
      allow create, delete: if souAdmin();
      // qualquer pessoa logada pode vincular seu uid a um colaborador livre,
      // ou o admin pode editar nome/uid
      allow update: if logado();
    }

    match /veiculos/{id} {
      allow read: if logado();
      allow create, delete: if souAdmin();
      allow update: if logado();
    }

    match /registrosUso/{id} {
      allow read: if logado();
      allow create, update: if logado();
      allow delete: if souAdmin();
    }

    match /tarefasDiarias/{id} {
      allow read: if logado();
      allow create, delete: if souAdmin();
      allow update: if logado();
    }

    match /checklistModelos/{id} {
      allow read: if logado();
      allow write: if souAdmin();
    }

    match /checklistRealizados/{id} {
      allow read: if logado();
      allow create: if logado();
      allow update, delete: if souAdmin();
    }
  }
}
